#!/usr/bin/env bash
# Builds the host platform's library, header and CLI with all optimizations,
# for both implementations, and links the commands into bin/<PF>/, where PF
# is the platform name <OS>-<ARCH> (OS linux, macos or mswin; ARCH amd64 or
# arm64): xattr-stream (C CLI, Zig core) and xattr-stream-rs (Rust).
#   ./build          release via `nix build`, kept at .nix-out/<PF>/ReleaseFast and .nix-out/<PF>/rust-release
#   ./build --debug  Debug builds via the dev shell (zig-out/<PF>/Debug, cargo's debug profile)
#   ./build --test   ReleaseSafe via the dev shell (zig-out/<PF>/ReleaseSafe, cargo's release profile)
# Without Nix: zig build --prefix zig-out/<PF>/ReleaseFast; cd rust && cargo build --release
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 2
# shellcheck source=scripts/pf.bash
source "$ROOT/scripts/pf.bash"

mode="release"
for arg in "$@"; do
	case "$arg" in
		--debug) mode="debug" ;;
		--test) mode="safe" ;;
		-h|--help)
			sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*) echo "build: unknown argument '$arg'" >&2; exit 2 ;;
	esac
done

pf="$(host_pf)" || { echo "build: unsupported host platform: $(uname -sm)" >&2; exit 2; }

# Points bin/<PF>/<command> at the product tree, only after a successful
# build, so a failed build leaves the previous working command in place.
# Windows gets copies: symlinks there need extra privileges.
# $1: product directory holding the command, $2: the command. Relative
# links for products inside the repository, absolute ones otherwise (a
# CARGO_TARGET_DIR elsewhere).
publish() {
	local dir="$1" cmd="$2" exe="" target
	[[ "$pf" == mswin-* ]] && exe=".exe"
	mkdir -p "bin/$pf"
	if [[ -n "$exe" ]]; then
		cp -f "$dir/$cmd$exe" "bin/$pf/$cmd$exe" || return 1
	else
		case "$dir" in
			/*) target="$dir/$cmd" ;;
			*) target="../../$dir/$cmd" ;;
		esac
		ln -sfn "$target" "bin/$pf/$cmd" || return 1
	fi
	echo "built: bin/$pf/$cmd$exe -> $dir/$cmd$exe"
}

cargo_dir="${CARGO_TARGET_DIR:-$ROOT/rust/target}"

case "$mode" in
	release)
		mkdir -p ".nix-out/$pf"
		nix build .#default -o ".nix-out/$pf/ReleaseFast" || exit 1
		nix build .#rust -o ".nix-out/$pf/rust-release" || exit 1
		publish ".nix-out/$pf/ReleaseFast/bin" xattr-stream
		publish ".nix-out/$pf/rust-release/bin" xattr-stream-rs
		;;
	debug)
		nix develop -c zig build -Doptimize=Debug --prefix "zig-out/$pf/Debug" || exit 1
		(cd rust && nix develop -c cargo build) || exit 1
		publish "zig-out/$pf/Debug/bin" xattr-stream
		publish "${cargo_dir#"$ROOT/"}/debug" xattr-stream-rs
		;;
	safe)
		nix develop -c zig build -Doptimize=ReleaseSafe --prefix "zig-out/$pf/ReleaseSafe" || exit 1
		(cd rust && nix develop -c cargo build --release) || exit 1
		publish "zig-out/$pf/ReleaseSafe/bin" xattr-stream
		publish "${cargo_dir#"$ROOT/"}/release" xattr-stream-rs
		;;
esac
