#!/usr/bin/env bash
# Builds the host platform's library, header and CLI with all optimizations
# and links the commands into bin/<PF>/, where PF is the platform name
# <OS>-<ARCH> (OS linux, macos or mswin; ARCH amd64 or arm64).
#   ./build          ReleaseFast via `nix build`, output kept at .nix-out/<PF>/ReleaseFast
#   ./build --debug  Debug build via the dev shell into zig-out/<PF>/Debug
#   ./build --test   ReleaseSafe build via the dev shell into zig-out/<PF>/ReleaseSafe
# Without Nix: zig build --prefix zig-out/<PF>/ReleaseFast
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 2
# shellcheck source=scripts/pf.bash
source "$ROOT/scripts/pf.bash"

mode="release"
for arg in "$@"; do
	case "$arg" in
		--debug) mode="debug" ;;
		--test) mode="safe" ;;
		-h|--help)
			sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*) echo "build: unknown argument '$arg'" >&2; exit 2 ;;
	esac
done

pf="$(host_pf)" || { echo "build: unsupported host platform: $(uname -sm)" >&2; exit 2; }

# Points bin/<PF>/<command> at the product tree, only after a successful
# build, so a failed build leaves the previous working command in place.
# Windows gets copies: symlinks there need extra privileges.
publish() {
	local product="$1" cmd exe=""
	[[ "$pf" == mswin-* ]] && exe=".exe"
	mkdir -p "bin/$pf"
	for cmd in xattr-stream; do
		if [[ -n "$exe" ]]; then
			cp -f "$product/bin/$cmd$exe" "bin/$pf/$cmd$exe" || return 1
		else
			ln -sfn "../../$product/bin/$cmd" "bin/$pf/$cmd" || return 1
		fi
		echo "built: bin/$pf/$cmd$exe -> $product/bin/$cmd$exe"
	done
}

case "$mode" in
	release)
		mkdir -p ".nix-out/$pf"
		nix build .#default -o ".nix-out/$pf/ReleaseFast" || exit 1
		publish ".nix-out/$pf/ReleaseFast"
		;;
	debug)
		nix develop -c zig build -Doptimize=Debug --prefix "zig-out/$pf/Debug" || exit 1
		publish "zig-out/$pf/Debug"
		;;
	safe)
		nix develop -c zig build -Doptimize=ReleaseSafe --prefix "zig-out/$pf/ReleaseSafe" || exit 1
		publish "zig-out/$pf/ReleaseSafe"
		;;
esac
