#!/usr/bin/env bash
# Cross-compiles both implementations for all six platforms (PF, <OS>-<ARCH>):
#   linux-amd64, linux-arm64 (static musl CLIs), macos-amd64, macos-arm64,
#   mswin-amd64, mswin-arm64
# Product trees:
#   Zig library and C CLI   .nix-out/cross/<PF>/ReleaseFast/{bin,lib}
#   Rust CLI and static lib .nix-out/rust-cross/<PF>/release/{bin,lib,include}
# Each platform's commands (xattr-stream, xattr-stream-rs) are linked into
# bin/<PF>/, except the host's, which ./build owns. Cross-compiling proves
# the code builds for a platform; it does not prove it runs there (see
# README).
# Without Nix: zig build cross --prefix <dir>, and for Rust a toolchain with
# the six targets plus cargo-zigbuild (see packages.rust-cross in flake.nix).
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 2
# shellcheck source=scripts/pf.bash
source "$ROOT/scripts/pf.bash"

host="$(host_pf)" || host=""
mkdir -p .nix-out
nix build .#cross -o .nix-out/cross || exit 1
nix build .#rust-cross -o .nix-out/rust-cross || exit 1

status=0
# publish PF PRODUCT_BIN_DIR COMMAND
publish() {
	local pf="$1" dir="$2" cmd="$3" exe=""
	[[ "$pf" == mswin-* ]] && exe=".exe"
	if [[ ! -f "$dir/$cmd$exe" ]]; then
		echo "build-all: missing $dir/$cmd$exe" >&2
		status=1
		return
	fi
	if [[ "$pf" == "$host" ]]; then
		echo "kept:  bin/$pf/$cmd$exe (host; ./build publishes it)"
		return
	fi
	mkdir -p "bin/$pf"
	ln -sfn "../../$dir/$cmd$exe" "bin/$pf/$cmd$exe" || status=1
	echo "built: bin/$pf/$cmd$exe -> $dir/$cmd$exe"
}

for pf in linux-amd64 linux-arm64 macos-amd64 macos-arm64 mswin-amd64 mswin-arm64; do
	publish "$pf" ".nix-out/cross/$pf/ReleaseFast/bin" xattr-stream
	publish "$pf" ".nix-out/rust-cross/$pf/release/bin" xattr-stream-rs
done
exit "$status"
