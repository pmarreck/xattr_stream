#!/usr/bin/env bash
# Runs the whole suite: Zig unit/integration tests, the C CLI over the public
# header via the Bash suite, every consumer, and the Rust implementation.
# No `set -e`: failures are accumulated and returned as the exit code.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 2

# Enter the flake's dev shell when the toolchain is not already on PATH. The
# check is for the tools themselves rather than IN_NIX_SHELL, because a stale
# direnv shell from an older flake can set IN_NIX_SHELL without providing
# them. Bubblewrap confines the build-script tests on Linux.
toolchain_ready() {
	command -v zig >/dev/null 2>&1 || return 1
	[[ "$(uname -s)" != Linux ]] || command -v bwrap >/dev/null 2>&1
}
if ! toolchain_ready && [[ -z "${XS_TEST_REEXEC:-}" ]] && command -v nix >/dev/null 2>&1; then
	XS_TEST_REEXEC=1 exec nix develop -c "$ROOT/test" "$@"
fi

# shellcheck source=scripts/pf.bash
source "$ROOT/scripts/pf.bash"
pf="$(host_pf)" || { echo "test: unsupported host platform: $(uname -sm)" >&2; exit 2; }
# The trees under test: built here, never whatever is on PATH.
OUT="zig-out/$pf/ReleaseFast"
RS="${CARGO_TARGET_DIR:-$ROOT/rust/target}/release"

failures=0
not_run=0
step() {
	local name="$1"
	shift
	printf '\n\033[1m== %s\033[0m\n' "$name"
	if "$@"; then
		printf '\033[32mok\033[0m %s\n' "$name"
	else
		printf '\033[31mFAIL\033[0m %s\n' "$name" >&2
		failures=$((failures + 1))
	fi
}

shared_ext=".so"
case "$(uname -s)" in
	Darwin) shared_ext=".dylib" ;;
	MINGW*|MSYS*|CYGWIN*) shared_ext=".dll" ;;
esac

step "zig build test" zig build test
step "zig build" zig build --prefix "$OUT"
step "cli (bash)" bash tests/cli/test_cli.sh "$OUT/bin/xattr-stream"
# The same suite with Windows conventions simulated (CRLF, /name switches).
step "cli (bash), OS=mswin" env OS=mswin bash tests/cli/test_cli.sh "$OUT/bin/xattr-stream"
step "cli conventions smoke (also run on the Windows runners)" bash tests/cli/conventions_smoke.sh "$OUT/bin/xattr-stream"
step "debug banner: release build is silent" bash tests/cli/debug_banner.sh "$OUT/bin/xattr-stream" release
debug_cli() {
	zig build -Doptimize=Debug --prefix "zig-out/$pf/Debug" && bash tests/cli/debug_banner.sh "zig-out/$pf/Debug/bin/xattr-stream" debug
}
step "debug banner: Debug build announces itself" debug_cli

# Runs a compile or link command and fails on any diagnostic it prints, so
# linker warnings (for example a macOS deployment-target mismatch) cannot
# hide behind a passing exit code.
quiet_build() {
	local log rc
	log="$("$@" 2>&1)"
	rc=$?
	if [[ $rc -ne 0 || -n "$log" ]]; then
		printf '%s\n' "$log" >&2
		[[ $rc -ne 0 ]] || echo "build printed diagnostics: $*" >&2
		return 1
	fi
}
consumer_c() {
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -I"$OUT/include" \
		-o "$TMPDIR/xs_consumer_c" tests/consumers/c/consumer.c "$OUT/lib/libxattr_stream.a" && "$TMPDIR/xs_consumer_c"
}
consumer_rust() {
	quiet_build rustc --edition 2021 -O -C link-arg="$OUT/lib/libxattr_stream.a" -o "$TMPDIR/xs_consumer_rs" tests/consumers/rust/consumer.rs && "$TMPDIR/xs_consumer_rs"
}
consumer_luajit() {
	luajit tests/consumers/luajit/consumer.lua "$OUT/lib/libxattr_stream$shared_ext"
}
# Builds the C consumer from nothing but what pkg-config reports, the way an
# outside project would, against the installed tree (relocatable .pc file).
consumer_pkgconfig() {
	# The .pc file is named by path rather than through PKG_CONFIG_PATH: the
	# Nix pkg-config wrapper replaces PKG_CONFIG_PATH with its own
	# platform-suffixed variable. Search-path lookup is covered by the
	# test-overlay-pkgconfig flake check, where the setup hook fills it.
	local pc="$ROOT/$OUT/lib/pkgconfig/xattr_stream.pc" flags libdir private all word
	libdir="$(pkg-config --variable=libdir "$pc")" || return 1
	# Static: -l would pick the .so when both exist, so link the archive from
	# the reported libdir plus the private libs, as a static consumer would.
	flags="$(pkg-config --cflags "$pc")" || return 1
	all="$(pkg-config --libs --static "$pc")" || return 1
	private=""
	for word in $all; do
		[[ "$word" == -lxattr_stream || "$word" == -L* ]] || private+=" $word"
	done
	# shellcheck disable=SC2086 # word splitting of pkg-config flags is intended
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -o "$TMPDIR/xs_consumer_pc_static" tests/consumers/c/consumer.c $flags "$libdir/libxattr_stream.a" $private || return 1
	"$TMPDIR/xs_consumer_pc_static" || return 1
	flags="$(pkg-config --cflags --libs "$pc")" || return 1
	# shellcheck disable=SC2086
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -o "$TMPDIR/xs_consumer_pc_shared" tests/consumers/c/consumer.c $flags -Wl,-rpath,"$libdir" || return 1
	"$TMPDIR/xs_consumer_pc_shared"
}
consumer_zig() {
	(cd tests/consumers/zig && zig build test)
}

# The Rust implementation (rust/): its own unit tests, a warning-free
# release build, the same CLI suite, a byte-for-byte differential against
# the C CLI, and the C ABI consumers linked against its library.
rust_unit() {
	(cd rust && cargo test --release --quiet)
}
rust_build() {
	(cd rust && quiet_build cargo build --release --quiet)
}
rust_debug_cli() {
	(cd rust && quiet_build cargo build --quiet) && bash tests/cli/debug_banner.sh "${RS%/release}/debug/xattr-stream-rs" debug
}
rust_version() {
	local zon cargo
	zon="$(sed -n 's/^ *\.version = "\(.*\)",$/\1/p' build.zig.zon)"
	cargo="$(sed -n 's/^version = "\(.*\)"$/\1/p' rust/Cargo.toml)"
	[[ -n "$zon" && "$zon" == "$cargo" ]] || { echo "build.zig.zon version '$zon' != rust/Cargo.toml version '$cargo'" >&2; return 1; }
}
consumer_c_over_rust() {
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -Iinclude \
		-o "$TMPDIR/xs_consumer_c_rs" tests/consumers/c/consumer.c -L"$RS" -lxattr_stream -Wl,-rpath,"$RS" && "$TMPDIR/xs_consumer_c_rs"
}
consumer_luajit_over_rust() {
	luajit tests/consumers/luajit/consumer.lua "$RS/libxattr_stream$shared_ext"
}

# Every step is required: a missing tool fails the run instead of skipping.
have() {
	local t
	for t in "$@"; do
		command -v "$t" >/dev/null 2>&1 && continue
		printf '\033[31mFAIL\033[0m %s not found (a required check cannot run)\n' "$t" >&2
		failures=$((failures + 1))
		return 1
	done
}

# Every system's outputs must still evaluate (a nixpkgs update once dropped
# x86_64-darwin, which only the macOS Intel runner noticed).
flake_eval() {
	local log
	log="$(nix flake check --all-systems --no-build 2>&1)" || { printf '%s\n' "$log" >&2; return 1; }
}
have nix && step "flake evaluates for all four Nix systems" flake_eval

# The build-script tests run ./build in disposable projects with fake
# builders, confined by scripts/run-isolated (Bubblewrap, Linux only):
# everything outside their scratch is read-only. The boundary is checked
# first against disposable sentinels under .build-work/.
canary() { bash tests/build/isolation_canary.sh "$@"; }
make_sentinel() {
	local s
	s="$(mktemp -d "$ROOT/.build-work/isolation-canary.XXXXXX")" || return 1
	printf 'original\n' >"$s/file" && printf 'other\n' >"$s/other" && ln -s file "$s/command" || return 1
	printf '%s' "$s"
}
isolation_boundary() {
	local s fp scratch rc=0
	mkdir -p "$ROOT/.build-work" || return 1
	# Control: the same attempts, unconfined, do change a sentinel.
	s="$(make_sentinel)" && scratch="$(mktemp -d "${TMPDIR:-/tmp}/xattr_stream_canary.XXXXXX")" || return 1
	fp="$(canary fingerprint "$s")"
	TEST_WORKSPACE="$scratch" canary attempt "$s" writable || rc=1
	[[ "$(canary fingerprint "$s")" != "$fp" ]] || { echo "control: unconfined writes changed nothing" >&2; rc=1; }
	chmod -R u+rwX "$s" && rm -rf "$s" "$scratch"
	# Confined: every attempt is refused and the sentinel is unchanged.
	s="$(make_sentinel)" || return 1
	fp="$(canary fingerprint "$s")"
	scripts/run-isolated -- bash tests/build/isolation_canary.sh attempt "$s" readonly || rc=1
	[[ "$(canary fingerprint "$s")" == "$fp" ]] || { echo "confined writes changed the sentinel" >&2; rc=1; }
	rm -rf "$s"
	# Private HOME and scratch are writable, each run starts empty, and the
	# child's exit status comes back.
	scripts/run-isolated -- bash -c ': >"$HOME/h" && : >"$TEST_WORKSPACE/seen"' || { echo "private scratch is not writable" >&2; rc=1; }
	scripts/run-isolated -- bash -c '[[ ! -e "$HOME/h" && ! -e "$TEST_WORKSPACE/seen" ]]' || { echo "scratch survived into the next run" >&2; rc=1; }
	scripts/run-isolated -- bash -c 'exit 7'
	[[ $? -eq 7 ]] || { echo "exit status not propagated" >&2; rc=1; }
	return "$rc"
}
# What the build-script tests must not touch: this checkout's selection,
# published commands and output links, inspected independently around the run.
live_build_state() {
	find CANONICAL_IMPL bin .nix-out -maxdepth 6 \( -type f -o -type l \) 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
		printf '%s %s\n' "$(ls -l "$f")" "$(cksum <"$f" 2>/dev/null)"
	done
}
build_script_confined() {
	local before rc=0
	before="$(live_build_state)"
	scripts/run-isolated -- bash tests/build/test_build.sh "$ROOT" || rc=1
	[[ "$(live_build_state)" == "$before" ]] || { echo "the build-script tests changed this checkout's build state" >&2; rc=1; }
	return "$rc"
}
if [[ "$(uname -s)" == Linux ]]; then
	if have bwrap; then
		failures_before=$failures
		step "isolation boundary (forbidden-write canaries)" isolation_boundary
		if [[ "$failures" -eq "$failures_before" ]]; then
			step "build script: selection, scopes, publication (confined)" build_script_confined
		else
			printf '\033[31mFAIL\033[0m build script tests not run: the isolation boundary failed\n' >&2
			failures=$((failures + 1))
		fi
	fi
else
	# No qualified write boundary here yet; Linux runners and the Nix checks
	# (test-build-script, test-build-real) cover ./build.
	printf '\n\033[33mNOT RUN\033[0m build script tests: no qualified write boundary on %s (they run on Linux, and in nix flake check on Linux)\n' "$(uname -s)"
	not_run=$((not_run + 1))
fi

have clang && step "consumer: C (clang)" consumer_c
have rustc && step "consumer: Rust" consumer_rust
have luajit && step "consumer: LuaJIT" consumer_luajit
have clang pkg-config && step "consumer: C via pkg-config" consumer_pkgconfig
step "consumer: Zig module" consumer_zig

if have cargo; then
	step "rust: version matches build.zig.zon" rust_version
	step "rust: cargo test" rust_unit
	step "rust: cargo build" rust_build
	step "rust: cli (bash)" bash tests/cli/test_cli.sh "$RS/xattr-stream-rs"
	step "rust: cli (bash), OS=mswin" env OS=mswin bash tests/cli/test_cli.sh "$RS/xattr-stream-rs"
	step "rust: cli conventions smoke" bash tests/cli/conventions_smoke.sh "$RS/xattr-stream-rs"
	step "rust: debug banner: release build is silent" bash tests/cli/debug_banner.sh "$RS/xattr-stream-rs" release
	step "rust: debug banner: debug build announces itself" rust_debug_cli
	step "rust: differential against the C CLI" bash tests/cli/differential.sh "$OUT/bin/xattr-stream" "$RS/xattr-stream-rs"
	step "rust: differential against the C CLI, OS=mswin" env OS=mswin bash tests/cli/differential.sh "$OUT/bin/xattr-stream" "$RS/xattr-stream-rs"
	have clang && step "rust: consumer: C over the Rust library" consumer_c_over_rust
	have luajit && step "rust: consumer: LuaJIT over the Rust library" consumer_luajit_over_rust
fi

printf '\n'
if [[ "$failures" -eq 0 ]]; then
	printf '\033[32mAll test steps passed\033[0m\n'
	[[ "$not_run" -eq 0 ]] || printf '\033[33m%d step(s) not run on this platform (see NOT RUN above)\033[0m\n' "$not_run"
else
	printf '\033[31m%d test step(s) failed\033[0m\n' "$failures" >&2
fi
exit "$failures"
