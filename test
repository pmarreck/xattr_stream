#!/usr/bin/env bash
# Runs the whole suite: Zig unit/integration tests, the C CLI over the public
# header via the Bash suite, and every consumer that has a toolchain here.
# No `set -e`: failures are accumulated and returned as the exit code.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT" || exit 2

# Enter the flake's dev shell when the toolchain is not already on PATH. The
# check is for zig itself rather than IN_NIX_SHELL, because a stale direnv
# shell from an older flake can set IN_NIX_SHELL without providing zig.
if ! command -v zig >/dev/null 2>&1 && [[ -z "${XS_TEST_REEXEC:-}" ]] && command -v nix >/dev/null 2>&1; then
	XS_TEST_REEXEC=1 exec nix develop -c "$ROOT/test" "$@"
fi

# shellcheck source=scripts/pf.bash
source "$ROOT/scripts/pf.bash"
pf="$(host_pf)" || { echo "test: unsupported host platform: $(uname -sm)" >&2; exit 2; }
# The trees under test: built here, never whatever is on PATH.
OUT="zig-out/$pf/ReleaseFast"
RS="${CARGO_TARGET_DIR:-$ROOT/rust/target}/release"

failures=0
step() {
	local name="$1"
	shift
	printf '\n\033[1m== %s\033[0m\n' "$name"
	if "$@"; then
		printf '\033[32mok\033[0m %s\n' "$name"
	else
		printf '\033[31mFAIL\033[0m %s\n' "$name" >&2
		failures=$((failures + 1))
	fi
}

shared_ext=".so"
case "$(uname -s)" in
	Darwin) shared_ext=".dylib" ;;
	MINGW*|MSYS*|CYGWIN*) shared_ext=".dll" ;;
esac

step "zig build test" zig build test
step "zig build" zig build --prefix "$OUT"
step "cli (bash)" bash tests/cli/test_cli.sh "$OUT/bin/xattr-stream"

# Runs a compile or link command and fails on any diagnostic it prints, so
# linker warnings (for example a macOS deployment-target mismatch) cannot
# hide behind a passing exit code.
quiet_build() {
	local log rc
	log="$("$@" 2>&1)"
	rc=$?
	if [[ $rc -ne 0 || -n "$log" ]]; then
		printf '%s\n' "$log" >&2
		[[ $rc -ne 0 ]] || echo "build printed diagnostics: $*" >&2
		return 1
	fi
}
consumer_c() {
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -I"$OUT/include" \
		-o "$TMPDIR/xs_consumer_c" tests/consumers/c/consumer.c "$OUT/lib/libxattr_stream.a" && "$TMPDIR/xs_consumer_c"
}
consumer_rust() {
	quiet_build rustc --edition 2021 -O -C link-arg="$OUT/lib/libxattr_stream.a" -o "$TMPDIR/xs_consumer_rs" tests/consumers/rust/consumer.rs && "$TMPDIR/xs_consumer_rs"
}
consumer_luajit() {
	luajit tests/consumers/luajit/consumer.lua "$OUT/lib/libxattr_stream$shared_ext"
}
# Builds the C consumer from nothing but what pkg-config reports, the way an
# outside project would, against the installed tree (relocatable .pc file).
consumer_pkgconfig() {
	# The .pc file is named by path rather than through PKG_CONFIG_PATH: the
	# Nix pkg-config wrapper replaces PKG_CONFIG_PATH with its own
	# platform-suffixed variable. Search-path lookup is covered by the
	# test-overlay-pkgconfig flake check, where the setup hook fills it.
	local pc="$ROOT/$OUT/lib/pkgconfig/xattr_stream.pc" flags libdir private all word
	libdir="$(pkg-config --variable=libdir "$pc")" || return 1
	# Static: -l would pick the .so when both exist, so link the archive from
	# the reported libdir plus the private libs, as a static consumer would.
	flags="$(pkg-config --cflags "$pc")" || return 1
	all="$(pkg-config --libs --static "$pc")" || return 1
	private=""
	for word in $all; do
		[[ "$word" == -lxattr_stream || "$word" == -L* ]] || private+=" $word"
	done
	# shellcheck disable=SC2086 # word splitting of pkg-config flags is intended
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -o "$TMPDIR/xs_consumer_pc_static" tests/consumers/c/consumer.c $flags "$libdir/libxattr_stream.a" $private || return 1
	"$TMPDIR/xs_consumer_pc_static" || return 1
	flags="$(pkg-config --cflags --libs "$pc")" || return 1
	# shellcheck disable=SC2086
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -o "$TMPDIR/xs_consumer_pc_shared" tests/consumers/c/consumer.c $flags -Wl,-rpath,"$libdir" || return 1
	"$TMPDIR/xs_consumer_pc_shared"
}
consumer_zig() {
	(cd tests/consumers/zig && zig build test)
}

# The Rust implementation (rust/): its own unit tests, a warning-free
# release build, the same CLI suite, a byte-for-byte differential against
# the C CLI, and the C ABI consumers linked against its library.
rust_unit() {
	(cd rust && cargo test --release --quiet)
}
rust_build() {
	(cd rust && quiet_build cargo build --release --quiet)
}
rust_version() {
	local zon cargo
	zon="$(sed -n 's/^ *\.version = "\(.*\)",$/\1/p' build.zig.zon)"
	cargo="$(sed -n 's/^version = "\(.*\)"$/\1/p' rust/Cargo.toml)"
	[[ -n "$zon" && "$zon" == "$cargo" ]] || { echo "build.zig.zon version '$zon' != rust/Cargo.toml version '$cargo'" >&2; return 1; }
}
consumer_c_over_rust() {
	quiet_build clang -std=c99 -Wall -Wextra -Werror -pedantic -Iinclude \
		-o "$TMPDIR/xs_consumer_c_rs" tests/consumers/c/consumer.c -L"$RS" -lxattr_stream -Wl,-rpath,"$RS" && "$TMPDIR/xs_consumer_c_rs"
}
consumer_luajit_over_rust() {
	luajit tests/consumers/luajit/consumer.lua "$RS/libxattr_stream$shared_ext"
}

if command -v clang >/dev/null 2>&1; then step "consumer: C (clang)" consumer_c; else echo "skip: clang not found"; fi
if command -v rustc >/dev/null 2>&1; then step "consumer: Rust" consumer_rust; else echo "skip: rustc not found"; fi
if command -v luajit >/dev/null 2>&1; then step "consumer: LuaJIT" consumer_luajit; else echo "skip: luajit not found"; fi
if command -v clang >/dev/null 2>&1 && command -v pkg-config >/dev/null 2>&1; then step "consumer: C via pkg-config" consumer_pkgconfig; else echo "skip: clang or pkg-config not found"; fi
step "consumer: Zig module" consumer_zig

if command -v cargo >/dev/null 2>&1; then
	step "rust: version matches build.zig.zon" rust_version
	step "rust: cargo test" rust_unit
	step "rust: cargo build" rust_build
	step "rust: cli (bash)" bash tests/cli/test_cli.sh "$RS/xattr-stream-rs"
	step "rust: differential against the C CLI" bash tests/cli/differential.sh "$OUT/bin/xattr-stream" "$RS/xattr-stream-rs"
	if command -v clang >/dev/null 2>&1; then step "rust: consumer: C over the Rust library" consumer_c_over_rust; fi
	if command -v luajit >/dev/null 2>&1; then step "rust: consumer: LuaJIT over the Rust library" consumer_luajit_over_rust; fi
else
	printf '\033[31mFAIL\033[0m rust: cargo not found (the Rust implementation is required)\n' >&2
	failures=$((failures + 1))
fi

printf '\n'
if [[ "$failures" -eq 0 ]]; then
	printf '\033[32mAll test steps passed\033[0m\n'
else
	printf '\033[31m%d test step(s) failed\033[0m\n' "$failures" >&2
fi
exit "$failures"
