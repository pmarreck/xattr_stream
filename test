#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
	exec nix develop -c bash -c './test'
fi

env -u CPATH -u C_INCLUDE_PATH -u CPLUS_INCLUDE_PATH -u OBJC_INCLUDE_PATH \
	-u NIX_CFLAGS_COMPILE -u NIX_CFLAGS_LINK -u NIX_LDFLAGS \
	make native >/dev/null
exec ./tests/test.sh "$ROOT/bin/xattr_stream"
